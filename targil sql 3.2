DROP TABLE IF EXISTS help_requests;

CREATE TABLE help_requests(
id INTEGER PRIMARY KEY AUTOINCREMENT,
visitor_name TEXT NOT NULL ,
urgency_level TEXT ,
wait_minutes INTEGER
);
